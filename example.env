# This file documents the environment variables that this server supports,
# as well as being an example configuration file.
# This file can be copied to '.env', where the server will then load its contents
# on startup.

# The MongoDB server that the server will connect to; this must have replication
# support enabled.
MONGO_HOST=mongodb://localhost:27017

# Admin token, used to add/remove contributors without needing to perform manual
# database operations. If this is not set (the default), the relevant endpoints
# are effectively rendered unavailable.
# If this server is exposed to the internet, this should be a secure value.
# One can be generated by running the following command:
#  $ python -c 'import secrets; print(secrets.token_urlsafe())'
#ADMIN_TOKEN=

# By default, request logs are suppressed as it's expected that this will be primarily served behind a
# reverse proxy that logs such requests independently.
# These logs may be helpful during development however, when you're likely sending requests against
# a local server directly; in which case, setting this to true is recommended.
#ENABLE_REQUEST_LOGGING=false
